; Engine configuration file.

config_version=5

[application]

config/name="Paddle Quest"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=90
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0

[xr]

openxr/enabled=true
shaders/enabled=true
; Suppresses the blocking "HMD not detected" modal on desktop runs.
; Note: this file is ConfigFile format - comments are ';', and a '#' line
; silently discards every setting after it in the section.
openxr/startup_alert=false
openxr/foveation_level=2
openxr/foveation_dynamic=true
