; Engine configuration file.

config_version=5

[application]

config/name="Paddle Quest"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=90
3d/default_gravity=9.8
; Physics runs at 90Hz; the headset does not. A Quest Pro is 90, a Quest 3
; offers 120, and a Steam Frame offers 72/80/90/120 plus an experimental 144.
; No single tick rate divides all of those, so instead of chasing the display
; we interpolate between physics frames and let the renderer run at whatever
; the compositor is pacing it at. Without this the ball and the paddle - the
; two fastest things on screen - visibly step at 90Hz on a 120Hz display.
;
; XRCamera3D and XRNode3D force their own interpolation mode to OFF in their
; constructors, so head and controller tracking is unaffected and keeps
; updating at render rate.
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0

[xr]

openxr/enabled=true
shaders/enabled=true
; Suppresses the blocking "HMD not detected" modal on desktop runs.
; Note: this file is ConfigFile format - comments are ';', and a '#' line
; silently discards every setting after it in the section.
openxr/startup_alert=false
; Foveation renders nothing at all on this Quest Pro (Godot 4.7.2, OpenXR
; vendors 5.1.0, runtime Oculus 207.218.0): the view goes black while audio
; and tracking carry on, with no error in logcat. Isolated across two builds -
; level 0 plays, level 2 is black, whether set here or at runtime.
openxr/foveation_level=0
openxr/foveation_dynamic=false
