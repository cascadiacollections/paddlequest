{
  "name": "Paddle Quest (Godot 4 + Android)",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "postCreateCommand": "just setup",
  "customizations": {
    "vscode": {
      "extensions": ["geequlim.godot-tools", "ms-azuretools.vscode-docker"],
      "settings": {
        "godotTools.editorPath.godot4": "/usr/local/bin/godot"
      }
    }
  },
  "runArgs": ["--device=/dev/bus/usb"],
  "mounts": [
    "source=paddlequest-gradle,target=/home/vscode/.gradle,type=volume"
  ]
}
