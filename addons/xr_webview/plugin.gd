@tool
extends EditorPlugin

## Installs the companion Android plugin when the addon is enabled.
##
## The node itself needs none of this - class_name registers project-wide, so
## XRWebPanel can be dropped into a scene whether or not the addon is enabled.
## What this does is the one step nothing else can do for you: the Android
## exporter scans exactly one directory for .gdap descriptors,
## res://android/plugins, and an AAR anywhere else is invisible to it.
##
## Both files are copied rather than referenced, because res://android is
## generated by the engine and is normally gitignored, so it cannot be the
## place the sources live.
##
## Building the AAR is still yours to run - `just shim` here, or gradlew in
## addons/xr_webview/android. This copies whatever has been built.

const PLUGIN_DIR := "res://android/plugins"
const SOURCE_DIR := "res://addons/xr_webview/android"
const DESCRIPTOR := "XRWebView.gdap"
const BINARY := "xr-webview-release.aar"
const BUILT_BINARY := "build/outputs/aar/xr-webview-release.aar"


func _enter_tree() -> void:
	_install()


func _install() -> void:
	var source := ProjectSettings.globalize_path(SOURCE_DIR)
	var target := ProjectSettings.globalize_path(PLUGIN_DIR)

	var built := source.path_join(BUILT_BINARY)
	if not FileAccess.file_exists(built):
		push_warning(
			(
				(
					"XR Web Panel: %s is not built, so the Android plugin was not installed. "
					+ "Run `just shim` (or gradlew assembleRelease in %s) and re-enable the addon."
				)
				% [BINARY, SOURCE_DIR]
			)
		)
		return

	if DirAccess.make_dir_recursive_absolute(target) != OK:
		push_error("XR Web Panel: could not create %s" % PLUGIN_DIR)
		return

	for pair in [[built, BINARY], [source.path_join(DESCRIPTOR), DESCRIPTOR]]:
		var error := DirAccess.copy_absolute(pair[0], target.path_join(pair[1]))
		if error != OK:
			push_error("XR Web Panel: could not install %s (error %d)" % [pair[1], error])
			return

	# Said out loud because the failure it prevents is silent: Godot detects a
	# plugin, writes no entry for it in the export preset, defaults it to off,
	# and exports successfully with the class missing. The panel then loads
	# pages with JavaScript disabled and nothing anywhere says why.
	print(
		(
			(
				"XR Web Panel: installed %s into %s. "
				+ "Set plugins/XRWebView=true in the Android export preset, or the "
				+ "plugin is silently left out of the APK."
			)
			% [BINARY, PLUGIN_DIR]
		)
	)
